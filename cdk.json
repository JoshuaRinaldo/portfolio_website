{
  "app": "python3 app.py",
  "context": {
  	"account": "324014232528",
    "region": "us-east-1",
    "environment": "prod",
    "hosted_zone_id": "Z06894253TINLH6L5UR69",
    "domain_name": "joshrinaldo.com",
    "platform": "arm64",
    "photo_bucket_exists": false,
    "lambda_functions": [
      {
        "function_type": "from_docker_image",
        "environment_variable_name": "INVOKE_MODEL_LAMBDA",
        "folder_name": "invoke_model",
        "route_path": "invoke",
        "timeout": 1,
        "policy_statements": [
          {
            "resources": ["*"],
            "actions": ["sagemaker:InvokeEndpoint"]
          }
        ]
      }
    ],
    "classification_models": {
      "sentiment": {
        "desired_label": "positive",
        "undesired_label": "negative"
      },
      "toxicity": {
        "desired_label": "neutral",
        "undesired_label": "toxic"
      },
      "malicious_url": {
        "desired_label": "BENIGN",
        "undesired_label": "MALWARE"
      },
      "grammar_error": {
        "desired_label": "OK",
        "undesired_label": "GRAMMAR_ERRORS"
      }
    },
    "sagemaker_endpoints": [
      {
        "endpoint_type": "image_and_model_data",
        "environment_variable_name": "GRAMMAR_ERROR_CLASSIFICATION_MODEL",
        "endpoint_name": "grammar-error-classifier",
        "dockerfile_folder": "serverless_explanations",
        "serverless_config": {
          "memory_size_in_mb": 6144,
          "max_concurrency": 1
        },
        "container_environment": {
            "SERVERLESS": "True",
            "HUB_MODEL_NAME": "nikolasmoya/c4-binary-english-grammar-checker"
        }
      },
      {
        "endpoint_type": "image_and_model_data",
        "environment_variable_name": "MALICIOUS_URL_CLASSIFICATION_MODEL",
        "endpoint_name": "malicious-url-classifier",
        "dockerfile_folder": "serverless_explanations",
        "serverless_config": {
          "memory_size_in_mb": 6144,
          "max_concurrency": 1
        },
        "container_environment": {
            "SERVERLESS": "True",
            "HUB_MODEL_NAME": "kmack/malicious-url-detection"
        }
      },
      {
        "endpoint_type": "image_and_model_data",
        "environment_variable_name": "SENTIMENT_CLASSIFICATION_MODEL",
        "endpoint_name": "sentiment-classifier",
        "dockerfile_folder": "serverless_explanations",
        "serverless_config": {
          "memory_size_in_mb": 6144,
          "max_concurrency": 1
        },
        "container_environment": {
            "SERVERLESS": "True",
            "HUB_MODEL_NAME": "cardiffnlp/twitter-roberta-base-sentiment-latest"
        }
      },
      {
        "endpoint_type": "image_and_model_data",
        "environment_variable_name": "TOXICITY_CLASSIFICATION_MODEL",
        "endpoint_name": "toxicity-classifier",
        "dockerfile_folder": "serverless_explanations",
        "serverless_config": {
          "memory_size_in_mb": 6144,
          "max_concurrency": 1
        },
        "container_environment": {
            "SERVERLESS": "True",
            "HUB_MODEL_NAME": "s-nlp/roberta_toxicity_classifier"
        }
      }
    ]
  }
}
